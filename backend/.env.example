APP_ENV=development
APP_NAME="Agentic Paper Trader API"
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=15
# Where scheduled ticks run: "celery" (a Celery worker via Redis; Compose/local) or
# "inline" (inside the API process; production on Render's free tier, #184).
SCHEDULER_EXECUTOR=celery
# Required for SCHEDULER_EXECUTOR=celery. Optional for inline: leave empty to run without Redis.
REDIS_URL=redis://localhost:6379/0
KILL_SWITCH_ENABLED=false

# Async SQLAlchemy connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_paper_trader
DATABASE_ECHO=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_paper_trader

# Auth Security (JWT) — generate a real random secret for production:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-value-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=agentic-paper-trader
JWT_EXPIRATION_MINUTES=30

# CORS Origins (JSON Array)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Alpaca Paper Trading API Secrets
# Get your free paper trading keys from https://app.alpaca.markets/
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_API_SECRET=your_alpaca_paper_api_secret_here
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
MAX_MARKET_DATA_AGE_MINUTES=15

# LLM Provider Secrets (Optional depending on chosen agent model)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Client Factory — switch providers with this one variable, no code changes.
LLM_PROVIDER=ollama              # "openai" | "ollama" | "anthropic"
# OPENAI_MODEL must support strict structured output (json_schema) and temperature.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
OLLAMA_JSON_FORMAT=true
# Server defaults for each agent's Ollama request timeout (30-900 s) and model keep-alive
# (-1 = keep loaded, 0 = unload after each call, up to 240 min). Agents can override
# both in Settings -> Agent configuration (#203). Ollama's own keep-alive default is 5 min.
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE_MINUTES=10

# Encrypted Alpaca Credential Vault — required. No default is baked into the app (a
# working key committed to source would make "encryption at rest" meaningless for
# anyone who forgets to override it). Generate your OWN key, don't reuse this one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=VTDBO4IWfNmWtf2JtjSTK2cGnfE71sNPb9GQx8kjyek=