APP_ENV=development
APP_NAME="Agentic Paper Trader API"

# Async SQLAlchemy connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_paper_trader
DATABASE_ECHO=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_paper_trader

# Auth Security (JWT) — generate a real random secret for production:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-value-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=agentic-paper-trader
JWT_EXPIRATION_MINUTES=30

# CORS Origins (JSON Array)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Alpaca Paper Trading API Secrets
# Get your free paper trading keys from https://app.alpaca.markets/
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_API_SECRET=your_alpaca_paper_api_secret_here
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# LLM Provider Secrets (Optional depending on chosen agent model)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Client Factory — switch providers with this one variable, no code changes.
LLM_PROVIDER=ollama              # "openai" | "ollama"
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
