APP_ENV=development
APP_NAME="Agentic Paper Trader API"

# Async SQLAlchemy connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_paper_trader
DATABASE_ECHO=false

# AuthSecurity (JWT) — generate a real random secret for anything beyond local dev,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ISSUER=agentic-paper-trader
JWT_EXPIRATION_MINUTES=30

# Origins allowed to call this API from a browser (JSON array)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
